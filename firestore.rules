rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function userExists() { 
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); 
    }
    
    function getUserData() { 
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {}; 
    }
    
    function isSuperAdmin() { 
      return isAuthenticated() && ('role' in getUserData()) && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      // Users can CREATE their own profile doc (for first-login provisioning) but ONLY as an
      // office_user — self-escalation to admin is blocked here; admins can create any profile
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.role == 'office_user' &&
          request.resource.data.officeId is string
        )
      );
      // Users can UPDATE their own profile but NOT change role, officeId, or status; admins can update any profile
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'officeId', 'status'])
        )
      );
      // Only admins can delete user profiles
      allow delete: if isSuperAdmin();
    }

    // Settings Collection
    match /settings/{document} {
      allow read: if isAuthenticated();
      // Admins can create/update any settings doc; office users can only write their own office profile
      allow create, update: if isAuthenticated() && userExists() && (
        isSuperAdmin() || document == getUserData().officeId
      );
      // Only admins can delete settings docs (workspace profiles)
      allow delete: if isSuperAdmin();
    }

    // Cases Collection - office-scoped access
    match /cases/{caseId} {
      // Users can read cases in their own office or cases they created; admins can read all
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        (userExists() && (
          resource.data.officeId == getUserData().officeId ||
          resource.data.createdByUid == request.auth.uid
        ))
      );
      // Users can create cases assigned to their own office
      allow create: if isAuthenticated() && userExists() && 
        request.resource.data.officeId == getUserData().officeId;
      // Users can update cases in their own office or cases they created; admins can update all
      allow update: if isAuthenticated() && userExists() && (
        isSuperAdmin() || (
          (resource.data.officeId == getUserData().officeId || resource.data.createdByUid == request.auth.uid) &&
          (!('officeId' in request.resource.data) || request.resource.data.officeId == resource.data.officeId) &&
          (!('createdByUid' in request.resource.data) || request.resource.data.createdByUid == resource.data.createdByUid)
        )
      );
      // Users can delete cases in their own office or cases they created; admins can delete all
      allow delete: if isAuthenticated() && userExists() && (
        isSuperAdmin() || 
        resource.data.officeId == getUserData().officeId ||
        resource.data.createdByUid == request.auth.uid
      );
    }

    // Trash Collection - admin can read/write all; users can write trash entries for their deleted cases
    match /trash/{caseId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated() && userExists() && (
        isSuperAdmin() ||
        request.resource.data.officeId == getUserData().officeId ||
        request.resource.data.createdByUid == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    // Audit Logs - admin only
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
